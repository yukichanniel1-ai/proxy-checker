{
  "telegram_bot_token": "YOUR_BOT_TOKEN_HERE",

  "chat_ids": {
    "proxy-file1": ["CHAT_ID_HERE"],
    "proxy-file2": ["CHAT_ID_HERE"],
    "proxy-file3": ["CHAT_ID_HERE"],
    "proxy-file4": ["CHAT_ID_HERE"],
    "proxy-file5": ["CHAT_ID_HERE"]
  },

  "checker": {
    "timeout_ms": 5000,
    "max_concurrent": 300,
    "min_speed_ms": 5,
    "max_speed_ms": 1000,
    "proxy_types": ["http", "socks4", "socks5"],
    "output_format": "ip:port",
    "refresh_interval_minutes": 5,
    "auto_loop": true
  }
}
